# MySQL Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fittrack_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# Database accounts bound to the fittrack_admin / fittrack_member roles (see database/security/roles.sql)
DB_ADMIN_PASSWORD=choose_a_strong_password
DB_MEMBER_PASSWORD=choose_a_different_strong_password

# Memurai / Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis ACL user 'ft_redis_member' (demo/09_redis_acl.sh)
REDIS_MEMBER_PASSWORD=choose_a_strong_redis_password

# Application Secrets
JWT_SECRET=development_secret_key_change_in_production
PORT=5000

# Optional: set to false to disable the "Continue as demo user" button/endpoint
DEMO_LOGIN_ENABLED=true
DEMO_USER_EMAIL=demo@fittrack.com
